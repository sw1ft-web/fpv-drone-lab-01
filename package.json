{
  "name": "fpv-drone-labs",
  "private": true,
  "version": "5.0.0",
  "type": "module",
  "workspaces": [
    "shared",
    "client",
    "server"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:netcode": "vitest run --project netcode",
    "netcode:sim": "node scripts/netcode-sim.ts",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p scripts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^9.17.0",
    "eslint-plugin-import": "^2.31.0",
    "fast-check": "^4.10.2",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
