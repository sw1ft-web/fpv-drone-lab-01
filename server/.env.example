# Copy to server/.env for local development (loaded via --env-file-if-exists).
PORT=3000
HOST=0.0.0.0
LOG_DIR=./logs
# Lab 4 debug routes: /api/slow?block=300 (sync block), /api/slow?delay=ms, /api/bad-json
DEBUG_ROUTES=true
MAX_ROOMS=20
MAX_PLAYERS_PER_ROOM=8
# --- Lab 8: operations ---
NODE_ENV=development
# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info
# Comma-separated browser origins allowed to open a WebSocket. Empty = same-origin only.
ALLOWED_ORIGINS=
MAX_CONNECTIONS_PER_IP=20
# Set true ONLY behind a reverse proxy you control (trusts X-Forwarded-For).
TRUST_PROXY=false
# If set, /metrics requires "Authorization: Bearer <token>".
METRICS_TOKEN=
# Build identifier shown in /health and fpv_build_info (Docker build arg).
GIT_SHA=dev
